# Cajal ICBM — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# NOTE: `bash docker-reload.sh rebuild` auto-generates CAJAL_CONFIG_KEY,
# CAJAL_DB_PASSWORD, and CAJAL_WATCHTOWER_TOKEN on first run. You do NOT need
# to set these manually — the script fills them in for you.

# ── Required (auto-generated on first run) ──────────────────────────────────

# Encryption key for secrets at rest. Auto-generated if missing or CHANGE_ME.
# Generate manually with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CAJAL_CONFIG_KEY=CHANGE_ME_generate_a_strong_random_key_here

# Previous key (used during rotation; remove after re-encryption is complete)
# CAJAL_CONFIG_KEY_PREVIOUS=

# PostgreSQL credentials (used by docker-compose and docker-reload.sh)
# DATABASE_URL is constructed automatically — no need to set it manually.
# CAJAL_DB_PASSWORD is auto-generated on first run if missing or CHANGE_ME.
CAJAL_DB_NAME=cajal
CAJAL_DB_USER=cajal
CAJAL_DB_PASSWORD=CHANGE_ME_password

# ── Authentication ──────────────────────────────────────────────────────────

# Enable TOTP MFA for local accounts (1 = enabled)
CAJAL_LOCAL_TOTP_ENABLED=1

# Force Secure flag on session cookies (set to 1 when behind HTTPS)
# CAJAL_FORCE_SECURE_COOKIES=0

# Session TTL (ms). Default: 8 hours
# CAJAL_SESSION_TTL_MS=28800000

# Idle session TTL (ms). Default: 30 minutes
# CAJAL_SESSION_IDLE_TTL_MS=1800000

# ── Network / Ports ─────────────────────────────────────────────────────────

# HTTP listen port
# PORT=4000

# Syslog listener ports (UDP + TCP)
# CAJAL_SYSLOG_UDP_PORT=5514
# CAJAL_SYSLOG_TCP_PORT=5514

# NetFlow listener port
# CAJAL_NETFLOW_PORT=2055

# ── Telemetry & Polling ─────────────────────────────────────────────────────

# Flow timeout (ms) before a protocol is considered stale. Default: 120000
# CAJAL_FLOW_TIMEOUT_MS=120000

# Syslog / NetFlow minimum stale window (ms). Default: 15 minutes
# CAJAL_SYSLOG_FLOW_TIMEOUT_MIN_MS=900000
# CAJAL_NETFLOW_FLOW_TIMEOUT_MIN_MS=900000

# SNMP poll interval (ms). Default: 60 seconds
# CAJAL_SNMP_POLL_INTERVAL_MS=60000

# Ping interval (ms). Default: 45 seconds
# CAJAL_PING_INTERVAL_MS=45000

# WAN speed test interval (ms). Default: 4 hours
# CAJAL_WAN_TEST_INTERVAL_MS=14400000

# ── Data Retention & Storage ─────────────────────────────────────────────────

# Event / log retention in days (1–3650). Default: 90
# CAJAL_DATA_RETENTION_DAYS=90

# In-memory event ring-buffer size. Default: 5000
# CAJAL_EVENT_RETENTION=5000

# Error / diagnostic / telemetry log caps
# CAJAL_ERROR_LOG_MAX_LINES=2000
# CAJAL_DIAGNOSTIC_LOG_MAX_LINES=5000
# CAJAL_TELEMETRY_LOG_MAX_LINES=200000

# ── Notifications ────────────────────────────────────────────────────────────

# Teams Power Automate webhook URL (must be https://)
# CAJAL_TEAMS_WEBHOOK_URL=

# SMTP (email notifications) — all optional
# CAJAL_SMTP_HOST=
# CAJAL_SMTP_PORT=587
# CAJAL_SMTP_SECURE=0
# CAJAL_SMTP_STARTTLS=auto
# CAJAL_SMTP_USER=
# CAJAL_SMTP_PASS=
# CAJAL_MAIL_FROM=

# ── Rate Limiting ────────────────────────────────────────────────────────────

# Login rate limit. Default: 20 attempts per 5 minutes
# CAJAL_LOGIN_RATE_LIMIT_MAX=20
# CAJAL_LOGIN_RATE_LIMIT_WINDOW_MS=300000

# Account lockout after repeated failures. Default: 8 failures / 15 minutes
# CAJAL_LOGIN_ACCOUNT_FAILURE_THRESHOLD=8
# CAJAL_LOGIN_ACCOUNT_FAILURE_WINDOW_MS=900000
# CAJAL_LOGIN_ACCOUNT_LOCK_MS=900000

# ── Database Pool ────────────────────────────────────────────────────────────

# Database SSL mode. Auto-detected by default:
#   - localhost/127.0.0.1 → 'disable' (safe for local Docker Postgres)
#   - Remote host          → 'require' (encrypted, self-signed certs OK)
# Explicit options: disable, require, verify-ca, verify-full
# CAJAL_DATABASE_SSL=

# CAJAL_DATABASE_POOL_MAX=20
# CAJAL_DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# CAJAL_DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# CAJAL_DATABASE_STATEMENT_TIMEOUT_MS=30000

# ── API Tokens ───────────────────────────────────────────────────────────────

# Maximum number of API tokens. Default: 200
# CAJAL_API_TOKEN_MAX_COUNT=200

# Maximum API token lifetime in days. Default: 90
# CAJAL_API_TOKEN_MAX_LIFETIME_DAYS=90

# ── Distributed State (optional) ─────────────────────────────────────────────

# Redis URL for distributed session / rate-limit state (multi-instance deployments)
# Leave unset to use in-memory state (single-instance only)
# CAJAL_REDIS_URL=redis://localhost:6379

# ── Collector Agent ───────────────────────────────────────────────────────────

# CAJAL_AGENT_SESSION_TTL_MS=120000
# CAJAL_AGENT_COMMAND_TIMEOUT_MS=30000
# CAJAL_AGENT_POLL_INTERVAL_MS=1500

# ── Display / UI ─────────────────────────────────────────────────────────────

# CAJAL_GLOBAL_CLOCK_TIMEZONE=UTC
# CAJAL_GLOBAL_CLOCK_HOUR_MODE=24h

# ── HTTPS (direct TLS, no proxy required) ────────────────────────────────────

# HTTPS listen port — only active when an SSL cert/key are configured in
# Settings → SSL Certificate. HTTP on PORT will redirect to this port.
# CAJAL_HTTPS_PORT=4443

# ── Auto-Update (Watchtower) ──────────────────────────────────────────────────
# These have sensible defaults — you do NOT need to set them for a standard
# install. The "Check for Updates" button works out of the box.
# The "Update Now" button requires Watchtower + token (auto-configured by
# docker-compose.yml and docker-reload.sh).

# GitHub repository to query for release versions (owner/repo format)
# Default: nniell90/cajal
# CAJAL_GITHUB_REPO=nniell90/cajal

# Container image to pull on update (shown in the update panel)
# Default: ghcr.io/nniell90/cajal:latest
# CAJAL_UPDATE_IMAGE=ghcr.io/nniell90/cajal:latest

# Watchtower HTTP API URL — internal Docker network only, not exposed publicly
# Default: http://cajal-watchtower:8080
# CAJAL_WATCHTOWER_URL=http://cajal-watchtower:8080

# Watchtower API token — auto-generated on first run by docker-reload.sh.
# Must match WATCHTOWER_HTTP_API_TOKEN used by the cajal-watchtower container.
# CAJAL_WATCHTOWER_TOKEN=
